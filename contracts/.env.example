# Deployment Configuration
# Copy this file to .env and fill in the values

# Private key for deployment (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URL for the network you're deploying to
RPC_URL=https://sepolia.infura.io/v3/your_infura_key

# Admin address for the RepoContract
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Set to true to deploy test tokens (USDC, TTBILL, SGD)
DEPLOY_TEST_TOKENS=false
