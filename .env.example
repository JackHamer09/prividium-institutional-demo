# Mint Amounts (in smallest unit - see decimals below)
# USDC: 6 decimals  → 100000000000 = 10,000 USDC
# TTBILL: 18 decimals → 100000000000000000000 = 100 tokens
# SGD: 18 decimals → 100000000000000000000 = 100 tokens
USDC_MINT_AMOUNT=10000000000
TTBILL_MINT_AMOUNT=100000000000000000000
SGD_MINT_AMOUNT=100000000000000000000

# Deposit Amount (ETH in wei)
# 1100000000000000000000 = 1100 ETH (1000 for deployer + 100 for repo contract)
DEPOSIT_AMOUNT=1100000000000000000000

# Repo Contract Funding (ETH in wei)
# 100000000000000000000 = 100 ETH
REPO_FUND_AMOUNT=100000000000000000000
