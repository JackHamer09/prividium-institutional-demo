# Nuxt Environment Configuration
# Copy this file to .env and fill in the values
# Default values match the Docker Compose setup (prividium-utils/docker-compose.yaml)

# Contract Addresses (set automatically by Docker Compose, fill in for manual setup)
NUXT_PUBLIC_INTRADAY_REPO_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Token Addresses
NUXT_PUBLIC_USDC_ADDRESS=0x0000000000000000000000000000000000000000
NUXT_PUBLIC_TUST_ADDRESS=0x0000000000000000000000000000000000000000
NUXT_PUBLIC_SGD_ADDRESS=0x0000000000000000000000000000000000000000

# Prividium Configuration
NUXT_PUBLIC_PRIVIDIUM_CLIENT_ID=institutional-demo
NUXT_PUBLIC_PRIVIDIUM_RPC_URL=http://localhost:8000/rpc
NUXT_PUBLIC_PRIVIDIUM_AUTH_BASE_URL=http://localhost:3001
NUXT_PUBLIC_PRIVIDIUM_PERMISSIONS_API_BASE_URL=http://localhost:8000

# Prividium Chain Configuration
NUXT_PUBLIC_PRIVIDIUM_CHAIN_ID=1337
NUXT_PUBLIC_PRIVIDIUM_CHAIN_NAME=Local Besu
NUXT_PUBLIC_PRIVIDIUM_BLOCK_EXPLORER_URL=http://localhost:3010
NUXT_PUBLIC_PRIVIDIUM_BLOCK_EXPLORER_NAME=Block Explorer
